# Python environment (large, machine-specific)
.venv/
venv/
__pycache__/
*.pyc

# Secrets: never commit keys or passwords (this project reads them from environment variables)
.env
.env.*
*.key

# Generated by the scripts (re-create by running them)
# outputs: predictions SQL, evaluation results, Power BI workbook
outputs/
# models: trained XGBoost files (re-create with train_and_predict.py)
models/
# logs: agent run traces (contain full questions and answers)
logs/
# external: live API pulls (re-create with fetch_external_data.py)
external/

# Editor / OS clutter
.DS_Store
.vscode/
.idea/
*.swp
~$*.xlsx
~$*.docx
